# Copy to .env and fill in real values. .env is gitignored.
PALCOS_DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require
PALCOS_SECRET_KEY=generate-with-python3-c-import-secrets-print-secrets-token-hex-32

# Optional: without this, new-request notifications are logged instead of sent.
RESEND_API_KEY=re_your_key_here
RESEND_FROM_EMAIL=Palcos <onboarding@resend.dev>

# Base URL used to build links in emails (runner.py). Defaults to localhost;
# set to the deployed URL (e.g. https://palcos.onrender.com) in production.
APP_BASE_URL=http://localhost:5050
